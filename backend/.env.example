# backend/.env.example
# Copy to backend/.env for local development. Never commit real values.
# In Vercel these are set as project environment variables, never in a file.

PORT=8080

# Postgres connection string. For Supabase use the pooler, see docs/despliegue.md.
DATABASE_URL=postgresql://user:password@host:port/dbname

# Secret that signs the login tokens: at least 32 characters, random.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=your_long_random_secret_here

# Browser origins allowed to call the API, comma separated, exact (no * and no paths).
CORS_ORIGINS=http://localhost:5173

# Maximum database connections per instance (default 4).
DB_MAX_CONNS=4

# Recipe photos in Supabase Storage (public bucket). Set all three or none: without them photo
# upload is disabled. The secret key has full access to the Supabase project: it lives only in
# the environment variables of the backend project in Vercel, never in a file you commit.
SUPABASE_URL=https://<your_project_ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_<your_secret_key>
# Name of the public bucket, for example recipe-photos.
SUPABASE_STORAGE_BUCKET=<your_bucket_name>
